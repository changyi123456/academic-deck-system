{
  "$comment": "唯一 design token source of truth。tokens.css 與 PPTX theme 皆由此生成，勿手動雙寫。",
  "version": "1.0.0",
  "canvas": {
    "aspect_ratio": "16:9",
    "logical_width": 1600,
    "logical_height": 900
  },
  "themes": {
    "board-dark": {
      "surface": {
        "canvas": "#1e2a24",
        "panel": "#26342c",
        "paper": "#2d3c33",
        "inset": "#18221c"
      },
      "text": {
        "primary": "#f2ede2",
        "secondary": "#b9c4bb",
        "muted": "#8a978d",
        "inverse": "#1e2a24"
      },
      "accent": {
        "primary": "#e8c46a",
        "secondary": "#8fb8d8"
      },
      "border": {
        "strong": "#e8c46a",
        "subtle": "#3c4a41"
      },
      "status": {
        "good": "#7fc7a8",
        "warn": "#e8c46a",
        "critical": "#d98aa3"
      },
      "data": {
        "series": ["#e8c46a", "#8fb8d8", "#7fc7a8", "#d98aa3", "#a99ae0", "#d98d6a", "#d9d4c8", "#6fc6c9"],
        "axis": "#b9c4bb",
        "grid": "#3c4a41"
      },
      "texture": {
        "grid_paper": "rgba(232,196,106,0.05)",
        "chalk_noise_opacity": 0.04
      }
    },
    "bright-minimal": {
      "surface": {
        "canvas": "#faf8f3",
        "panel": "#ffffff",
        "paper": "#f2eee4",
        "inset": "#ece7da"
      },
      "text": {
        "primary": "#22302a",
        "secondary": "#51605a",
        "muted": "#7d8a83",
        "inverse": "#faf8f3"
      },
      "accent": {
        "primary": "#a67c1e",
        "secondary": "#185fa5"
      },
      "border": {
        "strong": "#a67c1e",
        "subtle": "#d9d3c4"
      },
      "status": {
        "good": "#0f6e56",
        "warn": "#a67c1e",
        "critical": "#993556"
      },
      "data": {
        "series": ["#185fa5", "#0f6e56", "#a67c1e", "#993556", "#534ab7", "#993c1d", "#51605a", "#0f7d86"],
        "axis": "#51605a",
        "grid": "#e2ddd0"
      },
      "texture": {
        "grid_paper": "rgba(34,48,42,0.04)",
        "chalk_noise_opacity": 0
      }
    },
    "print": {
      "$comment": "PDF/黑白列印：由 bright-minimal 派生，移除紋理與陰影，強制純白底。",
      "extends": "bright-minimal",
      "surface": { "canvas": "#ffffff", "panel": "#ffffff", "paper": "#f5f5f5", "inset": "#eeeeee" },
      "texture": { "grid_paper": "transparent", "chalk_noise_opacity": 0 }
    }
  },
  "type": {
    "family": {
      "display": "'Noto Serif TC', serif",
      "body": "'Noto Sans TC', sans-serif",
      "mono": "'JetBrains Mono', monospace",
      "latin_fallback": "'Source Serif 4', Georgia, serif"
    },
    "scale": {
      "display": 72,
      "title": 48,
      "subtitle": 32,
      "body": 30,
      "emphasis": 34,
      "caption": 22,
      "citation": 18,
      "mono": 24,
      "eyebrow": 20
    },
    "line_height": { "display": 1.15, "title": 1.25, "body": 1.6, "caption": 1.4 },
    "min_projected_body_px": 28
  },
  "space": {
    "safe_x": 96,
    "safe_y": 72,
    "gutter": 32,
    "rhythm": 16,
    "panel_padding": 40
  },
  "stroke": {
    "diagram": 3,
    "chalk_underline": 4,
    "chart_line": 3,
    "chart_axis": 2
  },
  "radius": { "panel": 14, "chip": 8 },
  "signature": {
    "$comment": "個人風格簽名元素，SLIDE_STYLE.md 有使用規則。",
    "psi_mark": "ψ",
    "chalk_underline": true,
    "grid_paper_texture": true,
    "vector_arrow_style": "chalk-round-cap",
    "cer_chain_labels": { "claim": "主張 CLAIM", "evidence": "證據 EVIDENCE", "reasoning": "推理 REASONING" }
  }
}
