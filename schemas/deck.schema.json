{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "deck.schema.json",
  "title": "Academic Deck Spec",
  "description": "個人學術簡報系統的 canonical 內容格式。agent 只寫此格式，不直接寫 HTML。SSCI 文字型研究導向。",
  "type": "object",
  "required": ["schema_version", "deck", "slides"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": "1.0" },
    "deck": {
      "type": "object",
      "required": ["id", "title", "author", "language", "preset", "theme"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
        "title": { "type": "string", "maxLength": 60 },
        "subtitle": { "type": "string", "maxLength": 80 },
        "author": {
          "type": "object",
          "required": ["name"],
          "properties": {
            "name": { "type": "string" },
            "handle": { "type": "string" },
            "affiliation": { "type": "string" },
            "email": { "type": "string" }
          }
        },
        "event": { "type": "string" },
        "date": { "type": "string", "format": "date" },
        "language": { "enum": ["zh-Hant", "en"] },
        "secondary_language": { "enum": ["zh-Hant", "en"] },
        "preset": { "enum": ["seminar", "workshop", "defense"] },
        "theme": { "enum": ["board-dark", "bright-minimal", "print"] },
        "aspect_ratio": { "const": "16:9" },
        "outputs": {
          "type": "array",
          "items": { "enum": ["html", "pdf", "pptx"] },
          "default": ["html", "pdf", "pptx"]
        },
        "bibliography": { "type": "string", "description": "references.yaml 相對路徑" },
        "template_version": { "type": "string" }
      }
    },
    "slides": {
      "type": "array",
      "minItems": 3,
      "maxItems": 60,
      "items": { "$ref": "#/definitions/slide" }
    }
  },
  "definitions": {
    "slide": {
      "type": "object",
      "required": ["id", "type"],
      "properties": {
        "id": { "type": "string", "pattern": "^s[0-9]{2,3}[a-z]?$" },
        "type": {
          "enum": [
            "title", "section", "agenda", "statement", "content",
            "two-column", "comparison", "timeline-process", "quote",
            "figure-insight", "big-number",
            "research-question", "theory-framework", "literature-map",
            "method-design", "data-result", "stats-table", "coding-themes",
            "evidence-chain", "equation-focus",
            "summary", "limitations-future", "references", "qa-closing", "appendix"
          ]
        },
        "section": { "type": "string", "description": "所屬章節 slug，供頁腳章節標記" },
        "eyebrow": { "type": "string", "maxLength": 30 },
        "title": { "type": "string", "maxLength": 48 },
        "subtitle": { "type": "string", "maxLength": 72 },
        "claim": { "type": "string", "maxLength": 70, "description": "本頁唯一主張；每張 slide 只允許一個" },
        "meta": { "type": "array", "maxItems": 4, "items": { "type": "string", "maxLength": 40 }, "description": "title 頁的場合/日期/講者列" },
        "body": { "type": "string", "maxLength": 240, "description": "中文正文建議 45–90 字；validator 於 >120 字警告" },
        "bullets": { "type": "array", "maxItems": 5, "items": { "type": "string", "maxLength": 60 } },
        "panels": {
          "type": "array", "maxItems": 3,
          "items": {
            "type": "object", "required": ["heading"],
            "properties": {
              "heading": { "type": "string", "maxLength": 32 },
              "body": { "type": "string", "maxLength": 120 },
              "bullets": { "type": "array", "maxItems": 4, "items": { "type": "string", "maxLength": 50 } },
              "figure": { "$ref": "#/definitions/figure" }
            }
          }
        },
        "steps": {
          "type": "array", "maxItems": 6,
          "items": {
            "type": "object", "required": ["label"],
            "properties": {
              "label": { "type": "string", "maxLength": 20 },
              "detail": { "type": "string", "maxLength": 60 },
              "marker": { "type": "string", "maxLength": 12, "description": "時間點或階段編號" }
            }
          }
        },
        "figure": { "$ref": "#/definitions/figure" },
        "art": {
          "type": "object",
          "required": ["src"],
          "description": "裝飾性示意圖（GPT 生圖或 SVG），與數據 figure 分離；見 SLIDE_STYLE §9.5",
          "properties": {
            "src": { "type": "string" },
            "src_light": { "type": "string", "description": "bright-minimal/print 主題用的淺底變體；缺少時 background placement 在淺主題應停用而非顯示深圖" },
            "alt": { "type": "string" },
            "placement": { "enum": ["right", "left", "full", "background"], "default": "right" },
            "prompt": { "type": "string", "description": "生成此圖所用的完整 prompt，供重生成與風格一致性檢查" },
            "model": { "type": "string", "description": "生成模型名，如 gpt-image-1" }
          }
        },
        "hero_stat": {
          "type": "object",
          "required": ["value", "label"],
          "description": "巨大數字視覺主角（240px+ display 級）；見 SLIDE_STYLE §9.2",
          "properties": {
            "value": { "type": "string", "maxLength": 8 },
            "label": { "type": "string", "maxLength": 40 },
            "annotation": { "type": "string", "maxLength": 30, "description": "手繪風旁註文字" }
          }
        },
        "chart": { "$ref": "#/definitions/chart" },
        "table": { "$ref": "#/definitions/table" },
        "equation": {
          "type": "object", "required": ["latex"],
          "properties": {
            "latex": { "type": "string" },
            "label": { "type": "string" },
            "variables": {
              "type": "array",
              "items": {
                "type": "object", "required": ["symbol", "meaning"],
                "properties": {
                  "symbol": { "type": "string" },
                  "meaning": { "type": "string", "maxLength": 30 },
                  "unit": { "type": "string" }
                }
              }
            }
          }
        },
        "quote": {
          "type": "object", "required": ["text", "attribution"],
          "properties": {
            "text": { "type": "string", "maxLength": 160 },
            "attribution": { "type": "string", "maxLength": 60, "description": "受訪者代號或文獻作者；質性引語務必匿名化" },
            "context": { "type": "string", "maxLength": 60 }
          }
        },
        "themes": {
          "type": "array", "maxItems": 6,
          "description": "質性主題編碼（coding-themes 用）",
          "items": {
            "type": "object", "required": ["theme"],
            "properties": {
              "theme": { "type": "string", "maxLength": 24 },
              "code_count": { "type": "integer" },
              "example": { "type": "string", "maxLength": 80 },
              "participants": { "type": "string", "maxLength": 24 }
            }
          }
        },
        "cer": {
          "type": "object", "required": ["claim", "evidence", "reasoning"],
          "description": "CER 證據鏈（evidence-chain 用）",
          "properties": {
            "claim": { "type": "string", "maxLength": 60 },
            "evidence": { "type": "array", "minItems": 1, "maxItems": 4, "items": { "type": "string", "maxLength": 70 } },
            "reasoning": { "type": "string", "maxLength": 140 }
          }
        },
        "framework": {
          "type": "object",
          "description": "理論框架（theory-framework 用）：節點與關係，renderer 繪製",
          "required": ["nodes"],
          "properties": {
            "nodes": {
              "type": "array", "minItems": 2, "maxItems": 8,
              "items": {
                "type": "object", "required": ["id", "label"],
                "properties": {
                  "id": { "type": "string" },
                  "label": { "type": "string", "maxLength": 20 },
                  "role": { "enum": ["independent", "dependent", "mediator", "moderator", "context"] }
                }
              }
            },
            "edges": {
              "type": "array",
              "items": {
                "type": "object", "required": ["from", "to"],
                "properties": {
                  "from": { "type": "string" },
                  "to": { "type": "string" },
                  "label": { "type": "string", "maxLength": 16 },
                  "style": { "enum": ["solid", "dashed"] }
                }
              }
            },
            "figure": { "$ref": "#/definitions/figure" }
          }
        },
        "literature": {
          "type": "array", "maxItems": 8,
          "description": "文獻地圖（literature-map 用）",
          "items": {
            "type": "object", "required": ["cluster"],
            "properties": {
              "cluster": { "type": "string", "maxLength": 24 },
              "works": { "type": "array", "maxItems": 5, "items": { "type": "string", "maxLength": 40 } },
              "gap": { "type": "boolean", "description": "標記為研究缺口" }
            }
          }
        },
        "design": {
          "type": "object",
          "description": "研究設計（method-design 用）",
          "properties": {
            "approach": { "type": "string", "maxLength": 40 },
            "participants": { "type": "string", "maxLength": 60 },
            "instruments": { "type": "array", "maxItems": 5, "items": { "type": "string", "maxLength": 50 } },
            "procedure": { "type": "array", "maxItems": 6, "items": { "type": "string", "maxLength": 50 } },
            "analysis": { "type": "string", "maxLength": 80 }
          }
        },
        "stats": {
          "type": "array", "maxItems": 4,
          "items": {
            "type": "object", "required": ["label", "value"],
            "properties": {
              "label": { "type": "string" },
              "value": { "type": "string" },
              "note": { "type": "string", "maxLength": 40 }
            }
          }
        },
        "media": {
          "type": "object", "required": ["poster", "source"],
          "properties": {
            "poster": { "type": "string" },
            "src": { "type": "string" },
            "duration": { "type": "string" },
            "source": { "type": "string" },
            "fallback_url": { "type": "string" }
          }
        },
        "citation_ids": { "type": "array", "items": { "type": "string" } },
        "notes": { "type": "string", "description": "講者稿；每張都應填寫" },
        "footer": { "type": "string", "maxLength": 60 },
        "build": { "enum": ["none", "fade", "fragment"], "default": "none" },
        "custom_html": { "type": "string", "description": "escape hatch；使用時 validator 發出警告且 PPTX 輸出降級為圖片" }
      },
      "allOf": [
        { "if": { "properties": { "type": { "const": "title" } } }, "then": { "required": ["title"] } },
        { "if": { "properties": { "type": { "const": "statement" } } }, "then": { "required": ["claim"] } },
        { "if": { "properties": { "type": { "const": "research-question" } } }, "then": { "required": ["claim", "bullets"] } },
        { "if": { "properties": { "type": { "const": "theory-framework" } } }, "then": { "required": ["title", "framework"] } },
        { "if": { "properties": { "type": { "const": "literature-map" } } }, "then": { "required": ["title", "literature", "citation_ids"] } },
        { "if": { "properties": { "type": { "const": "method-design" } } }, "then": { "required": ["title", "design"] } },
        { "if": { "properties": { "type": { "const": "data-result" } } }, "then": { "required": ["claim"], "anyOf": [{ "required": ["chart"] }, { "required": ["table"] }, { "required": ["figure"] }] } },
        { "if": { "properties": { "type": { "const": "stats-table" } } }, "then": { "required": ["claim", "table"] } },
        { "if": { "properties": { "type": { "const": "coding-themes" } } }, "then": { "required": ["title", "themes"] } },
        { "if": { "properties": { "type": { "const": "evidence-chain" } } }, "then": { "required": ["cer"] } },
        { "if": { "properties": { "type": { "const": "quote" } } }, "then": { "required": ["quote"] } },
        { "if": { "properties": { "type": { "const": "equation-focus" } } }, "then": { "required": ["title", "equation"] } },
        { "if": { "properties": { "type": { "const": "figure-insight" } } }, "then": { "required": ["claim", "figure"] } },
        { "if": { "properties": { "type": { "const": "references" } } }, "then": { "required": [] } }
      ]
    },
    "figure": {
      "type": "object",
      "required": ["src", "alt", "source"],
      "properties": {
        "src": { "type": "string" },
        "alt": { "type": "string", "minLength": 4 },
        "caption": { "type": "string", "maxLength": 80 },
        "source": { "type": "string", "description": "圖片來源；自製標「作者自製」，GPT 生圖標「AI 生成（模型名）」" },
        "crop": { "enum": ["contain", "cover", "top", "center"] }
      }
    },
    "chart": {
      "type": "object",
      "required": ["kind", "alt", "takeaway", "source"],
      "properties": {
        "kind": { "enum": ["bar", "grouped-bar", "line", "scatter", "scatter-line", "box", "path-diagram", "pre-post"] },
        "data": { "type": "string", "description": "CSV 相對路徑" },
        "spec": { "type": "string", "description": "chart spec YAML 相對路徑" },
        "alt": { "type": "string", "minLength": 4 },
        "takeaway": { "type": "string", "maxLength": 60, "description": "一句話結論，顯示於圖表上方或旁側" },
        "unit": { "type": "string" },
        "sample_size": { "type": "string" },
        "source": { "type": "string" }
      }
    },
    "table": {
      "type": "object",
      "required": ["columns", "rows"],
      "properties": {
        "caption": { "type": "string", "maxLength": 60 },
        "columns": { "type": "array", "minItems": 2, "maxItems": 6, "items": { "type": "string", "maxLength": 20 } },
        "rows": {
          "type": "array", "minItems": 1, "maxItems": 8,
          "items": { "type": "array", "items": { "type": ["string", "number"] } }
        },
        "highlight": { "type": "array", "items": { "type": "integer" }, "description": "要強調的 row index（0-based）" },
        "note": { "type": "string", "maxLength": 80, "description": "表下註記，如 *p<.05, **p<.01" },
        "source": { "type": "string" }
      }
    }
  }
}
